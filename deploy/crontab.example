# KingDuck 홈서버 cron 예시 — `crontab -e` 에 붙여넣어 사용(경로는 실제 환경에 맞게 수정).
# 시간대는 서버 TZ 기준. KST 새벽에 돌리려면 서버를 Asia/Seoul 로 설정하거나 시간 보정.
#
# 전제: 아래 BASE 경로에 kingduck-server 가 있고, deploy/docker-compose.prod.yml 로 스택이 떠 있다.
#   BASE=/home/kingduck/kingduck-server

# ── 크롤러: 게임별 분산 실행(API 쿼터/부하 분산) ─────────────────────────
# 캐릭터/데이터는 주 1~수회면 충분, 영상은 매일.
# `run --rm`은 일회성 컨테이너로 크롤만 수행 후 종료.
# 주의: Puppeteer 게임(genshin/starrail/reverse1999/wutheringwaves)은 app 이미지에
#       Chromium deps 가 있어야 한다(README 참고). nikke 는 fetch 기반이라 무관.

# 니케: 캐릭터(주1, 일요일 04:00) + 영상(매일 04:30)
0 4 * * 0  cd /home/kingduck/kingduck-server && docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env.production run --rm app pnpm run crawl --game nikke --type character >> /var/log/kingduck/crawl.log 2>&1
30 4 * * * cd /home/kingduck/kingduck-server && docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env.production run --rm app pnpm run crawl --game nikke --type video >> /var/log/kingduck/crawl.log 2>&1

# (예시) 원신 캐릭터: 매주 월 05:00 — Chromium 이미지 필요
# 0 5 * * 1  cd /home/kingduck/kingduck-server && docker compose -f deploy/docker-compose.prod.yml --env-file deploy/.env.production run --rm app pnpm run crawl --game genshin --type character >> /var/log/kingduck/crawl.log 2>&1

# ── DB 백업: 매일 05:00 ──────────────────────────────────────────────
0 5 * * * /home/kingduck/kingduck-server/deploy/backup-db.sh >> /var/log/kingduck/backup.log 2>&1

# ── 프론트 재빌드+배포(코드 갱신 후, 필요 시 수동 또는 CI로 대체) ────────
# 0 6 * * 1 cd /home/kingduck/kingduck && git pull && pnpm install && pnpm run build >> /var/log/kingduck/build.log 2>&1
