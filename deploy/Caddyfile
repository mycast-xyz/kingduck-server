# Caddy 리버스 프록시 + 정적 프론트 + 자동 HTTPS(Let's Encrypt).
# DOMAIN 환경변수로 도메인 주입(compose에서 전달). 로컬 테스트는 DOMAIN=localhost(HTTP).
#
# 프론트(adapter-static)와 API를 같은 도메인으로 묶는다 → 동일 출처라 CORS 부담도 적다.
#   /api/*    → 백엔드 컨테이너(app:3000)
#   /assets/* → 백엔드가 서빙하는 크롤링 이미지
#   그 외      → 프론트 정적(SPA fallback: index.html)

{$DOMAIN:localhost} {
	encode gzip

	handle /api/* {
		reverse_proxy app:3000
	}

	handle /assets/* {
		reverse_proxy app:3000
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
