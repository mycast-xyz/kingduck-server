# Caddy 리버스 프록시 — Cloudflare Tunnel 뒤에서 동작.
#
# 공개 HTTPS는 Cloudflare(엣지)가 종단하고, cloudflared가 평문 HTTP로 이 Caddy(:80)에 접속한다.
# 따라서 Caddy는 도메인 기반 auto-HTTPS/HTTP→HTTPS 리다이렉트를 **하면 안 된다**(하면 cloudflared가
# 308 리다이렉트를 받아 origin 도달 실패 → Cloudflare 530/1033). 그래서 사이트 주소를 `:80`(평문)으로 둔다.
#
# cloudflared ingress는 이 서비스를 가리켜야 한다:  service: http://localhost:80
#
# 라우팅: /api·/assets → 백엔드(app:3000), 그 외 → 프론트 정적(SPA fallback).

:80 {
	encode gzip

	handle /api/* {
		reverse_proxy app:3000
	}

	handle /assets/* {
		reverse_proxy app:3000
	}

	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
