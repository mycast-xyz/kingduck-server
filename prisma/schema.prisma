generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Game {
  id          Int      @id @default(autoincrement())
  slug        String   @unique // 예: "genshin", "starrail", "wutheringwaves", "nikke", "reverse1999"
  name        String
  description String?
  iconUrl     String?  @map("icon_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  elements   Element[]
  characters Character[]
  items      Item[]
  videos     Video[]
  calendarEvents CalendarEvent[]

  @@map("games")
}

enum EventType {
  GACHA        // 캐릭터/무기 픽업
  EVENT        // 인게임 이벤트
  MAINTENANCE  // 업데이트 및 점검
  SPECIAL      // 방송, 오프라인 행사
}

model CalendarEvent {
  id           Int       @id @default(autoincrement())
  gameId       Int       @map("game_id")
  type         EventType
  title        String
  startTime    DateTime
  endTime      DateTime?
  
  imageUrl     String?   @map("image_url")
  officialLink String?   @map("official_link")
  
  targetId     String?   @map("target_id")
  metadata     Json?     
  
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  game         Game      @relation(fields: [gameId], references: [id])

  @@map("calendar_events")
  @@index([gameId, startTime])
  @@index([type])
}

model Element {
  id        Int      @id @default(autoincrement())
  gameId    Int      @map("game_id")
  name      String   // 예: "Pyro", "Fire", "Mineral", "Destruction", "Hunt"
  type      String   // "DamageType" 또는 "Path"
  iconUrl   String?  @map("icon_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  game              Game        @relation(fields: [gameId], references: [id])
  charactersElement Character[] @relation("CharacterElement")
  charactersPath    Character[] @relation("CharacterPath")

  @@map("elements")
  @@index([gameId])
  @@index([gameId, type])
}

model Character {
  id         Int     @id @default(autoincrement())
  gameId     Int     @map("game_id")
  elementId  Int?    @map("element_id")
  pathId     Int?    @map("path_id")
  name       String
  rarity     Int?    // 예: 4, 5
  weaponType String? // 예: "Sword", "AR", "Rectifier" (Generic weapon type)
  role       String? // 예: "DPS", "Support", "Defender"
  originalId String? @map("original_id")

  description String? @db.Text
  imageUrl    String? @map("image_url")

  // 게임별 데이터 (예: 별자리, 버스트 타입, 등급 등)
  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  game    Game     @relation(fields: [gameId], references: [id])
  element Element? @relation("CharacterElement", fields: [elementId], references: [id])
  path    Element? @relation("CharacterPath", fields: [pathId], references: [id])
  videos  Video[]

  @@map("characters")
  @@index([gameId])
  @@index([elementId])
  @@index([pathId])
}

model Item {
  id     Int    @id @default(autoincrement())
  gameId Int    @map("game_id")
  name   String
  type   String // 예: "Weapon", "Artifact", "Lightcone", "Echo", "Material"
  rarity Int?

  description String? @db.Text
  imageUrl    String? @map("image_url")

  // 게임별 스탯 및 속성 (예: 공격력, 부옵션, 재료 유형 등)
  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  game Game @relation(fields: [gameId], references: [id])

  @@map("items")
  @@index([gameId])
}

model Video {
  id           Int      @id @default(autoincrement())
  gameId       Int      @map("game_id")
  characterId  Int?     @map("character_id")
  title        String
  url          String   @unique
  thumbnailUrl String?  @map("thumbnail_url")
  localPath    String?  @map("local_path") // e.g., "assets/video/starrail/9Z9twPFh9iU.webm"
  type         String   // e.g., "KeyVisual", "Trailer", "Shorts"
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  game      Game       @relation(fields: [gameId], references: [id])
  character Character? @relation(fields: [characterId], references: [id])

  @@map("videos")
  @@index([gameId])
  @@index([characterId])
}

enum Role {
  USER
  MANAGER
  ADMIN
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  uuid      String   @unique
  role      Role     @default(USER)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}
