# kingduck-server 환경변수 예시. 실제 값은 .env(gitignored)에 두고 절대 커밋하지 말 것.

# PostgreSQL 연결 문자열 (Prisma가 사용)
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/DBNAME

# JWT 서명 키 — 강한 랜덤(≥256bit). 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 프로덕션에서는 반드시 환경변수로 주입(미설정 시 부팅 거부).
JWT_SECRET_KEY=

# 유튜브 데이터 API 키 (영상 크롤러용, 선택)
YOUTUBE_API_KEY=

# CORS 허용 origin 추가(콤마구분, 선택). 기본 화이트리스트에 더해진다.
# 예: https://kingduck.example.com,https://www.kingduck.example.com
CORS_ORIGINS=
